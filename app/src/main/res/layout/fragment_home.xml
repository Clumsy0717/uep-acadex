<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="90dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Acadex logo"
                    android:src="@drawable/acadex_logo" />

                <TextView
                    style="@style/Acadex.Display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:includeFontPadding="false"
                    android:text="Acadex" />
            </LinearLayout>

            <TextView
                style="@style/Acadex.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/poppins"
                android:text="Dashboard"
                android:textColor="@color/acadex_ink" />

            <TextView
                style="@style/Acadex.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A little reminder for you." />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <TextView
                    style="@style/Acadex.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Today’s Class Schedule"
                    android:textColor="@color/acadex_ink" />

                <TextView
                    android:id="@+id/tvClassCount"
                    style="@style/Acadex.Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    tools:text="0 Classes" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/classContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_navy"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvEmptyClasses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="No classes scheduled today. Tap Quick Links below."
                    android:textColor="@color/acadex_light"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <TextView
                    style="@style/Acadex.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reminders" />

                <TextView
                    android:id="@+id/tvReminderCount"
                    style="@style/Acadex.Count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    tools:text="0 reminders" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/reminderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyReminders"
                    style="@style/Acadex.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="No upcoming reminders. Tap Quick Links below."
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Dim overlay when speed dial is open -->
    <View
        android:id="@+id/fabOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <!-- Speed Dial FAB Container in bottom right corner -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Speed Dial Items (expanding upward) -->
        <LinearLayout
            android:id="@+id/speedDialMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Item 4: Campus Guide -->
            <LinearLayout
                android:id="@+id/itemCampusGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_pill"
                    android:elevation="4dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Campus Guide"
                    android:textColor="@color/acadex_ink"
                    android:textSize="12sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabCampusGuide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Campus Guide"
                    app:backgroundTint="@color/acadex_primary"
                    app:fabCustomSize="44dp"
                    app:icon="@drawable/ic_map"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Item 3: Add Reminders -->
            <LinearLayout
                android:id="@+id/itemAddReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_pill"
                    android:elevation="4dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Add Reminders"
                    android:textColor="@color/acadex_ink"
                    android:textSize="12sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabAddReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Add Reminders"
                    app:backgroundTint="@color/acadex_primary"
                    app:fabCustomSize="44dp"
                    app:icon="@drawable/ic_bell"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Item 2: Add Subject -->
            <LinearLayout
                android:id="@+id/itemAddSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_pill"
                    android:elevation="4dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Add Subject"
                    android:textColor="@color/acadex_ink"
                    android:textSize="12sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabAddSubject"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Add Subject"
                    app:backgroundTint="@color/acadex_primary"
                    app:fabCustomSize="44dp"
                    app:icon="@drawable/ic_book"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Item 1: Add Task -->
            <LinearLayout
                android:id="@+id/itemAddTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_pill"
                    android:elevation="4dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Add Task"
                    android:textColor="@color/acadex_ink"
                    android:textSize="12sp" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabAddTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Add Task"
                    app:backgroundTint="@color/acadex_primary"
                    app:fabCustomSize="44dp"
                    app:icon="@drawable/ic_add"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Circular Floating Action Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabQuickLinks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Quick Links"
            app:backgroundTint="@color/acadex_primary"
            app:fabSize="normal"
            app:icon="@drawable/ic_add"
            app:tint="@color/white" />

    </LinearLayout>

</FrameLayout>
