<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <include
            android:id="@+id/header"
            layout="@layout/view_header" />

        <TextView
            style="@style/Acadex.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Add Subject" />

        <TextView
            style="@style/Acadex.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Give your next task a place to start." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/Acadex.Label"
                android:text="Subject" />

            <EditText
                android:id="@+id/etSubject"
                style="@style/Acadex.Input"
                android:hint="Enter subject name"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Acadex.Label"
                android:text="Subject Code" />

            <EditText
                android:id="@+id/etCode"
                style="@style/Acadex.Input"
                android:hint="Enter subject code"
                android:inputType="textCapCharacters" />

            <TextView
                style="@style/Acadex.Label"
                android:text="Deadline Date" />

            <TextView
                android:id="@+id/tvDate"
                style="@style/Acadex.Input"
                android:drawableEnd="@drawable/ic_calendar"
                android:drawableTint="@color/acadex_muted"
                android:hint="Select a date" />

            <TextView
                style="@style/Acadex.Label"
                android:text="Deadline Time" />

            <TextView
                android:id="@+id/tvTime"
                style="@style/Acadex.Input"
                android:drawableEnd="@drawable/ic_clock"
                android:drawableTint="@color/acadex_muted"
                android:hint="Select a time" />

            <TextView
                style="@style/Acadex.Label"
                android:text="Task Description" />

            <EditText
                android:id="@+id/etDesc"
                style="@style/Acadex.Input"
                android:layout_height="130dp"
                android:gravity="top"
                android:hint="What do you need to work on?"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingTop="14dp"
                android:singleLine="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Acadex.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="Cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddTask"
                    style="@style/Acadex.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1.4"
                    android:text="Add Task"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvToast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill"
                android:drawableStart="@drawable/ic_check"
                android:drawablePadding="10dp"
                android:drawableTint="@color/acadex_ink"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="Task has been added"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
