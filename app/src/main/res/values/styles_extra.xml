<resources>

    <style name="Acadex" />

    <!-- Text -->
    <style name="Acadex.Display">
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">@color/acadex_ink</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>

    <style name="Acadex.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/acadex_heading</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="Acadex.Subtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/acadex_muted</item>
    </style>

    <style name="Acadex.Section">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/acadex_heading</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="Acadex.Count">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/acadex_ink</item>
    </style>

    <style name="Acadex.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/acadex_ink</item>
    </style>

    <style name="Acadex.Nav" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- Buttons -->
    <style name="Acadex.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/acadex_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/acadex_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Acadex.Button.Light">
        <item name="backgroundTint">@color/acadex_light</item>
        <item name="android:textColor">@color/acadex_ink</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Acadex.Button.Outline">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/acadex_ink</item>
        <item name="strokeColor">@color/acadex_border</item>
    </style>

    <!-- Form -->
    <style name="Acadex.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/acadex_heading</item>
    </style>

    <style name="Acadex.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/acadex_ink</item>
        <item name="android:textColorHint">@color/acadex_hint</item>
        <item name="android:singleLine">true</item>
    </style>

</resources>
